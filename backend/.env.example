MONGODB_URI=mongodb://127.0.0.1:27017/mizazy
JWT_SECRET=change-this-in-production
API_PORT=5000
NODE_ENV=development

# Site URLs
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000,https://mizazy.com,https://www.mizazy.com

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=mizazy

# Email (SMTP) — Hostinger mail server, shared by both mailboxes
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# Orders mailbox — order confirmations + new-order alerts
ORDERS_SMTP_USER=orders@mizazy.com
ORDERS_SMTP_PASS=your_orders_mailbox_password
ORDERS_MAIL_FROM=MIZAZY Orders <orders@mizazy.com>

# Customer mailbox — forgot-password links + welcome emails
CUSTOMER_SMTP_USER=customer@mizazy.com
CUSTOMER_SMTP_PASS=your_customer_mailbox_password
CUSTOMER_MAIL_FROM=MIZAZY Customer Care <customer@mizazy.com>

# Payment mailbox — online payment receipts
PAYMENT_SMTP_USER=payment@mizazy.com
PAYMENT_SMTP_PASS=your_payment_mailbox_password
PAYMENT_MAIL_FROM=MIZAZY Payments <payment@mizazy.com>

# Inbox that receives a copy of every new order
ADMIN_EMAIL=orders@mizazy.com

# Cashfree Payments (Dashboard → Developers → API Keys)
# CASHFREE_ENV: "sandbox" for test keys, "production" for live keys
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox
